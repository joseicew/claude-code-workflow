{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "@coding-solo/godot-mcp"]
    },
    "pixellab": {
      "type": "http",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PIXELLAB_TOKEN}"
      }
    }
  }
}
